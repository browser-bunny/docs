{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "BrowserBunny",
  "colors": {
    "primary": "#EA8DFF",
    "light": "#EA8DFF",
    "dark": "#EA8DFF"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              {
                "group": "Client setup",
                "pages": [
                  "client-setup",
                  "client-setup/agents",
                  "client-setup/humans"
                ]
              },
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Write and follow tests",
            "pages": [
              "environments",
              "conditions",
              "files",
              "results",
              "network",
              "errors-and-limits"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Environments",
            "pages": [
              "api-reference/list-environments"
            ]
          },
          {
            "group": "Tests",
            "pages": [
              "api-reference/create-test",
              "api-reference/list-tests",
              "api-reference/get-test",
              "api-reference/get-test-report",
              "api-reference/cancel-test",
              "api-reference/get-test-logs",
              "api-reference/get-test-network"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://browserbunny.dev/docs"
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://www.browserbunny.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open dashboard",
      "href": "https://dash.browserbunny.dev"
    }
  },
  "contextual": {
    "display": "header",
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "add-mcp",
      "cursor",
      "vscode"
    ]
  },
  "description": "Browser tests, in your words. Guides and reference for the BrowserBunny API.",
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#000000"
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "dark"
  },
  "icons": {
    "library": "lucide"
  },
  "api": {
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript"
      ],
      "autogenerate": false
    }
  }
}
